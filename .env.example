# Text_Writter Studio - Environment Configuration
# Optional: Hugging Face User Access Token (read permission)
# If provided, models query the Hugging Face Serverless Router API directly.
# If omitted, Text_Writter uses zero-config neural translation gateway out of the box.
HF_TOKEN=

# Optional: Set to 1 to enable local offline Hugging Face model execution via transformers
HF_LOCAL_INFERENCE=0
